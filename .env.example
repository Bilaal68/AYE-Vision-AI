# Copy this file to .env and change passwords before sharing the machine.

# Database
POSTGRES_DB=secint_db
POSTGRES_USER=secint_admin
POSTGRES_PASSWORD=secint_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
SECRET_KEY=django-insecure-change-me-in-any-shared-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend (Vite)
# Use /api so the Vite dev server can proxy to Django (avoids CORS during local npm run dev).
VITE_API_BASE_URL=/api
